// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  documents     Document[]
  sessions      ChatSession[]
  refreshTokens RefreshToken[]

  posts    Post[]
  comments PostComment[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sentEmailCampaigns EmailCampaign[] @relation("CampaignSender")
  emailRecipients    EmailRecipient[] @relation("RecipientUser")

  @@index([courseId])
}

enum Role {
  student
  admin
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  ipAddress String?
  userAgent String?
}

model Document {
  id           String          @id @default(uuid())
  title        String
  fileUrl      String
  publicId     String
  fileType     String?
  uploadedBy   User            @relation(fields: [uploadedById], references: [id])
  uploadedById String
  status       DocumentStatus  @default(PROCESSING)
  chunks       DocumentChunk[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model DocumentChunk {
  id         String   @id @default(uuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  chunkIndex Int
  content    String
  createdAt  DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model ChatSession {
  id        String        @id @default(uuid())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
}

model ChatMessage {
  id        String      @id @default(uuid())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())
}

enum MessageRole {
  user
  assistant
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

model Course {
  id   Int    @id @default(autoincrement())
  name String @unique

  users          User[]
  posts          Post[]
  emailCampaigns EmailCampaign[]
}

model Post {
  id String @id @default(uuid())

  title   String?
  content String

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  imageUrl    String?
  documentUrl String?

  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments PostComment[]

  @@index([courseId])
  @@index([authorId])
  @@index([createdAt])
}

model PostComment {
  id String @id @default(uuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  content String

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

model EmailCampaign {
  id String @id @default(uuid())

  subject String
  body    String

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  senderId String
  sender   User @relation("CampaignSender", fields: [senderId], references: [id])

  status EmailStatus @default(DRAFT)

  recipients EmailRecipient[]

  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  failedCount     Int @default(0)

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([courseId])
  @@index([status])
  @@index([createdAt])
}

model EmailRecipient {
  id String @id @default(uuid())

  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id])

  userId String
  user   User @relation("RecipientUser", fields: [userId], references: [id])

  email String

  status RecipientStatus @default(PENDING)

  sentAt       DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  @@unique([campaignId, userId])

  @@index([campaignId])
  @@index([userId])
  @@index([status])
}

enum EmailStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
}
